-          (bind "SUPER + N" (dsp.exec "${swaync-client} -t -sw"))
-          (bind "SUPER + SHIFT + N" (dsp.exec "${swaync-client} -d -sw"))
+          (bindOpts "SUPER + C" (dsp.exec "alacritty --class clipse -e ${pkgs.clipse}/bin/clipse") {description = "Open clipboard history";})
